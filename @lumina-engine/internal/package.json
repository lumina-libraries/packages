{
  "name": "@lumina-engine/internal",
  "version": "0.0.0",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.d.ts"
    },
    "./editor/*": {
      "types": "./editor/*",
      "default": "./editor/*"
    },
    "./shared/*": {
      "types": "./shared/*",
      "default": "./shared/*"
    },
    "./sandbox/*": {
      "types": "./sandbox/*",
      "default": "./sandbox/*"
    }
  },
  "files": [
    "index.d.ts",
    "events.d.ts",
    "external-modules.d.ts",
    "editor",
    "shared",
    "sandbox"
  ]
}
